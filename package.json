{
  "name": "tailscale-toggle",
  "version": "0.2.0",
  "description": "Decky plugin: toggle Tailscale and your self-hosted services (OpenClaw gateway) from the Quick Access Menu",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aanze/tailscale-toggle-decky.git"
  },
  "keywords": ["decky-plugin", "tailscale", "openclaw", "steam-deck", "armada"],
  "author": "aanze",
  "license": "MIT",
  "dependencies": {
    "@decky/api": "1.1.3",
    "@decky/ui": "4.11.6"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "rollup": "4.62.0",
    "shx": "0.4.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
