{
  "name": "deckops",
  "version": "0.3.0",
  "description": "Decky plugin: Tailscale toggle, service switches (OpenClaw gateway) and a chat box to your on-device agent",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aanze/deckops-decky.git"
  },
  "keywords": [
    "decky-plugin",
    "tailscale",
    "openclaw",
    "steam-deck",
    "armada",
    "odin"
  ],
  "author": "aanze",
  "license": "MIT",
  "dependencies": {
    "@decky/api": "1.1.3",
    "@decky/ui": "4.11.6"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "rollup": "4.62.0",
    "shx": "0.4.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
